# -*- coding: utf-8 -*-
"""
Wall_Thickness_Analysis.FCMacro
-------------------------------
Fast wall thickness analysis for injection moulded parts (sphere method).

Method: at every surface sample point the largest sphere that touches the
surface there, has its centre on the inward normal and stays inside the
material is determined. Wall thickness = diameter of that sphere. Surface
points are found with a spatial grid, so the analysis takes a few seconds.
The result is a colour map (3-colour gradient: minimum / nominal / maximum)
plus a numeric report. Nothing is added to your document.

Workflow (a small dialog guides you):
  1. Select the part(s) - a solid, a Body or a Part object (or only some
     faces of it) - in the tree or in the 3D view.
  2. Enter minimum / nominal / maximum wall thickness and press ANALYZE.
     The colours and the report update instantly when you change the values.

Colours:  minimum = blue,  nominal = green,  maximum = red  (blended in
between, clamped outside), grey = no result.
Click a face in the 3D view to print the thickness at the clicked point.
A colour scale (legend) is shown in the top-left corner of the 3D view.

Accuracy: about 0.1 mm on flat and smoothly curved walls (flat walls are
exact); a few tenths of a mm on strongly curved thin walls. Works on closed
solids. Values are in FreeCAD's internal unit (mm) for input; results are
reported in the length units of the session.
"""

import re
from math import sqrt, ceil
from itertools import chain

import numpy as np
import FreeCAD
import FreeCADGui as Gui
import Part
from FreeCAD import Vector
from pivy import coin

try:
    from PySide import QtCore, QtGui, QtWidgets
except ImportError:                      # older FreeCAD
    from PySide import QtCore, QtGui
    QtWidgets = QtGui


# ======================================================================
#  Numeric core (pure numpy)                                  [CORE START]
# ======================================================================

class Cancelled(Exception):
    pass


def _unit(N):
    L = np.linalg.norm(N, axis=1, keepdims=True)
    L[L < 1e-300] = 1.0
    return N / L


def vertex_normals(V, T):
    """Area weighted vertex normals of an indexed triangle mesh."""
    tn = np.cross(V[T[:, 1]] - V[T[:, 0]], V[T[:, 2]] - V[T[:, 0]])
    N = np.zeros_like(V)
    for k in range(3):
        np.add.at(N, T[:, k], tn)
    return _unit(N)


def triangle_areas(V, T):
    return 0.5 * np.linalg.norm(
        np.cross(V[T[:, 1]] - V[T[:, 0]], V[T[:, 2]] - V[T[:, 0]]), axis=1)


def bisect_soup(P, Nr, h, max_iter=60):
    """Longest-edge bisection of a triangle soup until every edge is <= h.
    P, Nr: (m, 3, 3) corner positions / normals. Keeps winding. Produces
    evenly shaped triangles (no slivers) even from long thin triangles."""
    done_P, done_N = [], []
    for _ in range(max_iter):
        e = np.stack([np.linalg.norm(P[:, 1] - P[:, 0], axis=1),
                      np.linalg.norm(P[:, 2] - P[:, 1], axis=1),
                      np.linalg.norm(P[:, 0] - P[:, 2], axis=1)], axis=1)
        small = e.max(axis=1) <= h
        if small.any():
            done_P.append(P[small])
            done_N.append(Nr[small])
        big = ~small
        if not big.any():
            break
        P, Nr, e = P[big], Nr[big], e[big]
        k = e.argmax(axis=1)
        i = np.arange(len(P))
        a, b, c = P[i, k], P[i, (k + 1) % 3], P[i, (k + 2) % 3]
        na, nb, nc = Nr[i, k], Nr[i, (k + 1) % 3], Nr[i, (k + 2) % 3]
        m = 0.5 * (a + b)
        nm = _unit(0.5 * (na + nb))
        P = np.concatenate([np.stack([a, m, c], 1), np.stack([m, b, c], 1)])
        Nr = np.concatenate([np.stack([na, nm, nc], 1), np.stack([nm, nb, nc], 1)])
    else:
        done_P.append(P)
        done_N.append(Nr)
    return np.concatenate(done_P), np.concatenate(done_N)


def weld(P, Nr, q=1e-5):
    """Merge coincident corners of a triangle soup -> indexed mesh (V, N, T)."""
    flat = P.reshape(-1, 3)
    key = np.round(flat / q).astype(np.int64)
    order = np.lexsort((key[:, 2], key[:, 1], key[:, 0]))
    ks = key[order]
    new = np.ones(len(ks), dtype=bool)
    new[1:] = (ks[1:] != ks[:-1]).any(axis=1)
    gid = np.cumsum(new) - 1
    inv = np.empty(len(ks), dtype=np.int64)
    inv[order] = gid
    first = order[new]
    return flat[first], Nr.reshape(-1, 3)[first], inv.reshape(-1, 3)


def refine_face(V, N, T, h):
    P, Nr = bisect_soup(V[T], N[T], h)
    return weld(P, Nr)


def thin_indices(P, fid, cell):
    """Indices of one point per (cell, face): a hard way to reduce an over-dense
    cloud (points of different faces stay separate, so thin walls are not merged)."""
    key = np.column_stack([np.floor(P / cell).astype(np.int64), fid.astype(np.int64)])
    order = np.lexsort((key[:, 3], key[:, 2], key[:, 1], key[:, 0]))
    ks = key[order]
    new = np.ones(len(ks), dtype=bool)
    new[1:] = (ks[1:] != ks[:-1]).any(axis=1)
    return order[new]


def refine_set(meshes, idxs, h0, budget, progress=None):
    """Refine the faces idxs to an even spacing h (>= h0) so that the total number
    of vertices stays near `budget` (refinement never coarsens: if the meshes are
    already finer, the vertex count simply stays as it is and the caller thins it).
    Returns ({idx: (V,N,T)}, h)."""
    area = sum(triangle_areas(meshes[i][0], meshes[i][2]).sum() for i in idxs)
    h_start = max(h0, sqrt(max(area, 1e-12) / (0.6 * budget)))
    h, prev = h_start, None
    for _ in range(8):
        out = {}
        for n_, i in enumerate(idxs):
            if progress and n_ % 20 == 0:
                progress()
            out[i] = refine_face(*meshes[i], h=h)
        total = sum(len(o[0]) for o in out.values())
        if total <= 1.3 * budget:
            return out, h
        if prev is not None and total >= 0.98 * prev:
            return out, h_start
        prev = total
        h *= max(1.1, sqrt(total / budget))
    return out, h_start


class GridIndex(object):
    """Uniform hash grid over a point cloud (numpy only)."""

    def __init__(self, pts, reach, cell_div=2.0):
        pts = np.asarray(pts, dtype=float)
        self.cell = float(reach) / cell_div
        self.o = pts.min(axis=0) - self.cell
        ij = np.floor((pts - self.o) / self.cell).astype(np.int64)
        self.dim = ij.max(axis=0) + 3
        key = self._key(ij)
        order = np.argsort(key, kind='stable')
        self.order = order
        self.sp = pts[order]
        self.ukey, self.ustart, self.ucount = np.unique(
            key[order], return_index=True, return_counts=True)
        K = int(ceil(cell_div)) + 1
        rng = range(-K, K + 1)
        self.offs = []
        for a in rng:
            for b in rng:
                for c in rng:
                    gap2 = sum(max(0, abs(x) - 1) ** 2 for x in (a, b, c))
                    if gap2 * self.cell ** 2 <= reach ** 2 + 1e-12:
                        self.offs.append(np.array((a, b, c), dtype=np.int64))

    def _key(self, ij):
        return (ij[:, 0] * self.dim[1] + ij[:, 1]) * self.dim[2] + ij[:, 2]

    def candidates(self, Q, chunk=4000, progress=None):
        """Yield (qi, pi): query index and index into self.sp of every cloud
        point lying in the cells that can hold points within `reach`."""
        base_all = np.floor((np.asarray(Q) - self.o) / self.cell).astype(np.int64)
        nu = len(self.ukey)
        for s in range(0, len(Q), chunk):
            if progress:
                progress()
            base = base_all[s:s + chunk]
            for off in self.offs:
                nij = base + off
                valid = ((nij >= 0) & (nij < self.dim)).all(axis=1)
                if not valid.any():
                    continue
                nkey = self._key(nij)
                pos = np.minimum(np.searchsorted(self.ukey, nkey), nu - 1)
                hit = valid & (self.ukey[pos] == nkey)
                qi = np.flatnonzero(hit)
                if qi.size == 0:
                    continue
                st = self.ustart[pos[qi]]
                ct = self.ucount[pos[qi]]
                tot = int(ct.sum())
                rep = np.repeat(qi, ct)
                idx = np.arange(tot) - np.repeat(np.cumsum(ct) - ct, ct) + np.repeat(st, ct)
                yield s + rep, idx


try:                                        # optional, much faster neighbour search
    from scipy.spatial import cKDTree
except Exception:                           # pragma: no cover
    cKDTree = None


class KDIndex(object):
    """Same interface as GridIndex, backed by scipy's cKDTree."""

    def __init__(self, pts, reach):
        self.sp = np.asarray(pts, dtype=float)
        self.order = np.arange(len(self.sp))
        self.reach = float(reach)
        self.tree = cKDTree(self.sp)

    def candidates(self, Q, chunk=4000, progress=None):
        Q = np.asarray(Q)
        for s in range(0, len(Q), chunk):
            if progress:
                progress()
            tq = cKDTree(Q[s:s + chunk])
            res = tq.sparse_distance_matrix(self.tree, self.reach, output_type='ndarray')
            if len(res) == 0:
                continue
            yield res['i'].astype(np.int64) + s, res['j'].astype(np.int64)


def make_index(pts, reach):
    if cKDTree is not None:
        return KDIndex(pts, reach)
    return GridIndex(pts, reach)


class ObstacleField(object):
    """Surface point cloud (with outward normals) used to find the largest
    inscribed sphere."""

    def __init__(self, cloud, cloud_n, r_cap, spacing):
        self.r_cap = float(r_cap)
        self.spacing = float(spacing)
        self.grid = make_index(cloud, r_cap + 1.0 * spacing)
        self.sn = np.asarray(cloud_n, dtype=float)[self.grid.order]

    def radii(self, P, Nin, progress=None, sin_phi=0.1):
        """Radius of the largest sphere that touches the surface at P (centre on
        the inward normal Nin) and contains no surface point.
        Point test : sphere tangent at p contains q  <=>  r > |q-p|^2 / (2 n.(q-p)).
        Plane test : a sphere tangent at p and touching the local surface plane
                     (point q, outward normal m) has r = (q-p).m / (1 + n.m);
                     exact on flat walls whatever the sample spacing."""
        P = np.asarray(P, dtype=float)
        Nin = np.asarray(Nin, dtype=float)
        r_cap = self.r_cap
        hclose2 = (1.0 * self.spacing) ** 2
        C = P + Nin * r_cap
        rmin = np.full(len(P), r_cap)
        g = self.grid
        lim2 = (r_cap + 1.2 * self.spacing) ** 2
        for qi, pi in g.candidates(C, progress=progress):
            q = g.sp[pi]
            keep = ((q - C[qi]) ** 2).sum(axis=1) <= lim2          # cheap pre-filter
            if not keep.any():
                continue
            qi, pi, q = qi[keep], pi[keep], q[keep]
            vec = q - P[qi]
            d2 = (vec * vec).sum(axis=1)
            n = Nin[qi]
            nq = (vec * n).sum(axis=1)
            ok_pt = (nq > sin_phi * np.sqrt(d2)) & (d2 > 1e-12)
            with np.errstate(divide='ignore', invalid='ignore'):
                rcand = np.where(ok_pt, d2 / (2.0 * np.maximum(nq, 1e-12)), np.inf)
            m = self.sn[pi]
            den = 1.0 + (n * m).sum(axis=1)
            vm = (vec * m).sum(axis=1)
            okp = np.flatnonzero((den > 0.3) & (vm > 0) & (d2 > 1e-12))
            if okp.size:
                rp = vm[okp] / den[okp]
                contact = P[qi[okp]] + rp[:, None] * (n[okp] + m[okp])
                close = ((contact - q[okp]) ** 2).sum(axis=1) <= hclose2
                sel = okp[close]
                rcand[sel] = np.minimum(rcand[sel], rp[close])
            better = rcand < rmin[qi]
            if better.any():
                np.minimum.at(rmin, qi[better], rcand[better])
        return rmin


def recover_edges(P, t, vface, r_cap, reach, progress=None):
    """Near sharp convex edges the sphere tangent at a point is blocked by the
    neighbouring face, which gives a narrow, false 'thin' band. Inside the same
    face a point inherits the thickness of a neighbour that is closer than
    (its sphere radius + reach)."""
    out = t.copy()
    r = 0.5 * t
    grid = make_index(P, r_cap + reach)
    for qi, pi in grid.candidates(P, progress=progress):
        ti = grid.order[pi]                                  # target (original index)
        same = vface[qi] == vface[ti]
        if not same.any():
            continue
        qi, pi, ti = qi[same], pi[same], ti[same]
        gain = t[qi] > out[ti]
        if not gain.any():
            continue
        qi, pi, ti = qi[gain], pi[gain], ti[gain]
        d2 = ((grid.sp[pi] - P[qi]) ** 2).sum(axis=1)
        ok = d2 <= (r[qi] + reach) ** 2
        if ok.any():
            np.maximum.at(out, ti[ok], t[qi][ok])
    return out


def assign_nearest(Pm, tm, fm, P, fid, reach):
    """Value of the nearest measured point (same face) for every point of P.
    Points without a measured neighbour inside `reach` become NaN."""
    out = np.full(len(P), np.nan)
    best = np.full(len(P), np.inf)
    idx = make_index(Pm, reach)
    for qi, pi in idx.candidates(P):
        mi = idx.order[pi]
        ok = fm[mi] == fid[qi]
        if not ok.any():
            continue
        qi, mi, pi = qi[ok], mi[ok], pi[ok]
        d2 = ((idx.sp[pi] - P[qi]) ** 2).sum(axis=1)
        o = np.lexsort((d2, qi))
        qi, mi, d2 = qi[o], mi[o], d2[o]
        first = np.ones(len(qi), dtype=bool)
        first[1:] = qi[1:] != qi[:-1]
        qi, mi, d2 = qi[first], mi[first], d2[first]
        better = d2 < best[qi]
        out[qi[better]] = tm[mi[better]]
        best[qi[better]] = d2[better]
    return out


def analyze_meshes(meshes, sample_idx, t_cap, progress=None,
                   h_obst=1.0, n_obst=60000, n_org=12000, min_face_area=0.01,
                   org_meshes=None):
    """meshes: list (one per face) of (V, N, T) in global coordinates with
    outward normals (or None). Returns dict with the refined sample mesh and
    the wall thickness at every sample point (cap value where >= t_cap)."""
    progress = progress or (lambda msg=None: None)
    meshes = [m if (m is not None and len(m[2])) else None for m in meshes]
    # org_meshes: (coarser) tessellation used for the sample points / colour map
    om = meshes if org_meshes is None else \
        [m if (m is not None and len(m[2])) else None for m in org_meshes]
    all_idx = [i for i, m in enumerate(meshes) if m is not None]
    sample_idx = [i for i in sample_idx if om[i] is not None]
    if not all_idx or not sample_idx:
        raise ValueError("No triangles - nothing to analyse.")
    # tiny sliver faces (a few nm wide) only produce meaningless values
    sample_idx = [i for i in sample_idx
                  if triangle_areas(om[i][0], om[i][2]).sum() >= min_face_area]
    if not sample_idx:
        raise ValueError("The selected faces are too small to analyse.")

    progress("Building surface point cloud ...")
    cl, h = refine_set(meshes, all_idx, h_obst, n_obst, progress)
    cloud = np.vstack([cl[i][0] for i in all_idx])
    cloud_n = np.vstack([cl[i][1] for i in all_idx])
    cloud_f = np.concatenate([np.full(len(cl[i][0]), i) for i in all_idx])
    del cl
    # the tessellation may already be finer than needed: thin it to the budget
    if len(cloud) > 1.3 * n_obst:
        cell = 0.5 * h
        keep = np.arange(len(cloud))
        while len(keep) > 1.3 * n_obst:
            cell *= 1.25
            keep = thin_indices(cloud, cloud_f, cell)
        cloud, cloud_n = cloud[keep], cloud_n[keep]
        h = max(h, 1.5 * cell)

    progress("Building sample mesh ...")
    org, h_o = refine_set(om, sample_idx, h, n_org, progress)
    RV, RN, RT, vf, tf = [], [], [], [], []
    off = 0
    for i in sample_idx:
        V, N, T = org[i]
        RV.append(V)
        RN.append(N)
        RT.append(T + off)
        vf.append(np.full(len(V), i))
        tf.append(np.full(len(T), i))
        off += len(V)
    RV, RN, RT = np.vstack(RV), np.vstack(RN), np.vstack(RT)
    vf, tf = np.concatenate(vf), np.concatenate(tf)

    # Too many sample points for the chosen limit: measure an evenly spread subset
    # (one point per cell and face) and give every other point the value of the
    # nearest measured point of the same face.
    sub = None
    if len(RV) > 1.15 * n_org:
        cell = h_o
        sub = np.arange(len(RV))
        while len(sub) > n_org:
            cell *= 1.12
            sub = thin_indices(RV, vf, cell)
        progress("Evenly distributing %d of %d points over the part ..." % (len(sub), len(RV)))
    Pm, Nm, fm = (RV, RN, vf) if sub is None else (RV[sub], RN[sub], vf[sub])
    h_m = h_o if sub is None else cell

    r_cap = 0.5 * t_cap
    progress("Computing inscribed spheres at %d points ..." % len(Pm))
    field = ObstacleField(cloud, cloud_n, r_cap, h)
    bad = np.linalg.norm(RN, axis=1) < 0.5
    r = field.radii(Pm, -_unit(Nm), progress)
    t = 2.0 * r
    progress("Cleaning up edge zones ...")
    for _ in range(2):                      # two passes also fix 3-face corners
        t = recover_edges(Pm, t, fm, r_cap, 1.2 * h_m, progress)
    if sub is not None:
        t = assign_nearest(Pm, t, fm, RV, vf, 1.75 * cell)
    t[bad] = np.nan
    return {"V": RV, "N": RN, "T": RT, "vface": vf, "tface": tf, "thick": t,
            "field": field, "t_cap": t_cap, "h_obst": h, "h_org": h_o,
            "n_cloud": len(cloud)}


def thickness_stats(res, t_lo, t_hi):
    """Global and per-face statistics."""
    th, T = res["thick"], res["T"]
    areas = triangle_areas(res["V"], T)
    with np.errstate(all='ignore'):
        tri = np.nanmean(th[T], axis=1)
    known = ~np.isnan(tri)
    tot = max(areas.sum(), 1e-300)
    g = {"area_thin": float(areas[known & (tri < t_lo)].sum() / tot),
         "area_thick": float(areas[known & (tri > t_hi)].sum() / tot)}
    if known.any():
        g["mean"] = float((areas[known] * tri[known]).sum() / areas[known].sum())
        g["min"] = float(np.nanmin(th))
        g["max"] = float(np.nanmax(th))
        g["min_pos"] = res["V"][int(np.nanargmin(th))]
    else:
        g["mean"] = g["min"] = g["max"] = g["min_pos"] = None
    faces = {}
    for fi in np.unique(res["vface"]):
        v = th[res["vface"] == fi]
        v = v[~np.isnan(v)]
        faces[int(fi)] = (float(v.min()), float(v.mean()), float(v.max())) if v.size else None
    return g, faces


def colors3(th, t_min, t_nom, t_max):
    """3-colour gradient: min = blue, nominal = green, max = red."""
    col = np.tile(np.array([0.6, 0.6, 0.6]), (len(th), 1))
    k = ~np.isnan(th)
    t = th[k]
    blue, green, red = np.array([0, 0.2, 1.0]), np.array([0, 0.85, 0.1]), np.array([1.0, 0, 0])
    a = np.clip((t - t_min) / max(t_nom - t_min, 1e-9), 0, 1)[:, None]
    b = np.clip((t - t_nom) / max(t_max - t_nom, 1e-9), 0, 1)[:, None]
    c = np.where(t[:, None] <= t_nom, blue + a * (green - blue), green + b * (red - green))
    col[k] = c
    return col

