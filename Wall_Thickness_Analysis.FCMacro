# ======================================================================
#  FreeCAD side
# ======================================================================

def face_mesh(face, tol):
    """Tessellate one face -> (V, N, T) with normals pointing out of the
    material (checked against the surface normal), or None."""
    try:
        pts, tris = face.tessellate(tol)
    except Exception:
        return None
    if not pts or not tris:
        return None
    V = np.array([[p.x, p.y, p.z] for p in pts], dtype=float)
    T = np.array(tris, dtype=np.int64)
    N = vertex_normals(V, T)
    try:                                   # orientation check vs. the true surface normal
        u0, u1, v0, v1 = face.ParameterRange
        votes, found = 0.0, 0
        for i in range(3):
            for j in range(3):
                if found >= 4:
                    break
                u = u0 + (u1 - u0) * (i + 0.5) / 3
                v = v0 + (v1 - v0) * (j + 0.5) / 3
                try:
                    if not face.isPartOfDomain(u, v):
                        continue
                    ns = face.normalAt(u, v)
                    p = face.valueAt(u, v)
                except Exception:
                    continue
                k = int(np.argmin(((V - np.array([p.x, p.y, p.z])) ** 2).sum(1)))
                votes += float(np.dot(N[k], [ns.x, ns.y, ns.z]))
                found += 1
        if found and votes < 0:
            T = T[:, [0, 2, 1]]
            N = -N
    except Exception:
        pass
    return V, N, T


def get_shape(obj, sub):
    try:
        sh = Part.getShape(obj, sub, needSubElement=True)
        if sh is not None and not sh.isNull():
            return sh
    except Exception:
        pass
    return None


def targets_from_selection():
    """list of dicts: obj, shape (whole object), sample (set of face indices)."""
    targets = {}
    for s in Gui.Selection.getSelectionEx('', 0):
        obj = s.Object
        t = targets.setdefault(obj.Name, {"obj": obj, "sample": set(), "all": False})
        for sub in (s.SubElementNames or ('',)):
            last = sub.split('.')[-1] if sub else ''
            m = re.match(r'^Face(\d+)$', last)
            if m and obj.TypeId.startswith("Part::"):
                t["sample"].add(int(m.group(1)) - 1)
            else:
                t["all"] = True
    out = []
    for t in targets.values():
        sh = get_shape(t["obj"], '')
        if sh is None or not sh.Faces:
            continue
        t["shape"] = sh
        t["plain"] = False
        try:
            t["plain"] = (t["obj"].TypeId.startswith("Part::") and
                          len(t["obj"].Shape.Faces) == len(sh.Faces))
        except Exception:
            pass
        n = len(sh.Faces)
        if t["all"] or not t["sample"]:
            t["sample"] = set(range(n))
        t["sample"] = {i for i in t["sample"] if 0 <= i < n}
        out.append(t)
    return out


def user_len(mm):
    try:
        return FreeCAD.Units.Quantity(mm, FreeCAD.Units.Length).UserString
    except Exception:
        return "%.3f mm" % mm


def view_widget():
    """The widget of the active 3D view (parent for the colour scale)."""
    try:
        mdi = Gui.getMainWindow().findChild(QtWidgets.QMdiArea)
        sub = mdi.activeSubWindow()
        return sub.widget() if sub is not None else None
    except Exception:
        return None


def _split_unit(mm):
    """('2,500', 'mm') style split of a length in the session's units."""
    s = user_len(mm)
    parts = s.rsplit(' ', 1)
    if len(parts) == 2 and not parts[1].replace('.', '').replace(',', '').isdigit():
        return parts[0], parts[1]
    return s, ''


class LegendWidget(QtWidgets.QWidget):
    """Vertical colour scale drawn over the 3D view (top-left corner)."""

    def __init__(self, parent):
        super(LegendWidget, self).__init__(parent)
        self.setAttribute(QtCore.Qt.WA_TransparentForMouseEvents)
        self.limits = (1.0, 2.5, 4.0)
        self.setGeometry(12, 12, 190, 330)

    def set_limits(self, t_min, t_nom, t_max):
        self.limits = (t_min, t_nom, t_max)
        self.update()

    def paintEvent(self, ev):
        t_min, t_nom, t_max = self.limits
        p = QtGui.QPainter(self)
        p.setRenderHint(QtGui.QPainter.Antialiasing)
        p.setPen(QtCore.Qt.NoPen)
        p.setBrush(QtGui.QColor(255, 255, 255, 190))
        p.drawRoundedRect(self.rect().adjusted(0, 0, -1, -1), 6, 6)

        unit = _split_unit(1.0)[1]
        bold = QtGui.QFont(self.font())
        bold.setBold(True)
        p.setPen(QtGui.QColor(20, 20, 20))
        p.setFont(bold)
        p.drawText(12, 22, "Wall thickness")
        p.setFont(self.font())
        p.drawText(12, 40, "(sphere method)")
        if unit:
            p.drawText(12, 60, unit)

        x0, w = 14, 26
        y0, y1 = 74, 312                       # top = maximum, bottom = minimum
        f = (t_nom - t_min) / max(t_max - t_min, 1e-9)
        f = min(max(f, 0.0), 1.0)
        grad = QtGui.QLinearGradient(0, y0, 0, y1)
        grad.setColorAt(0.0, QtGui.QColor(255, 0, 0))
        grad.setColorAt(1.0 - f, QtGui.QColor(0, 217, 26))
        grad.setColorAt(1.0, QtGui.QColor(0, 51, 255))
        p.setBrush(QtGui.QBrush(grad))
        p.setPen(QtGui.QColor(40, 40, 40))
        p.drawRect(x0, y0, w, y1 - y0)

        def ypos(v):
            return y1 - (min(max(v, t_min), t_max) - t_min) / max(t_max - t_min, 1e-9) * (y1 - y0)

        ticks = [(t_min + (t_max - t_min) * i / 5.0, False) for i in range(6)]
        ticks.append((t_nom, True))
        fm = QtGui.QFontMetrics(self.font())
        last_y = None
        for v, is_nom in sorted(ticks, key=lambda a: -a[0]):
            y = ypos(v)
            num = _split_unit(v)[0]
            if abs(v - t_max) < 1e-9 and not is_nom:
                num = "> " + num
            elif abs(v - t_min) < 1e-9 and not is_nom:
                num = "< " + num
            p.setPen(QtGui.QColor(40, 40, 40))
            p.drawLine(x0 + w, int(y), x0 + w + 6, int(y))
            if last_y is not None and abs(y - last_y) < fm.height() * 0.9 and not is_nom:
                continue                      # keep the labels readable
            p.setFont(bold if is_nom else self.font())
            p.drawText(x0 + w + 10, int(y + fm.ascent() / 2.0 - 1), num + ("  (nominal)" if is_nom else ""))
            last_y = y
        p.end()


SAMPLE_LIMITS = [25000, 50000, 75000, 100000]   # selectable maximum number of spheres


class WallThicknessDialog(QtWidgets.QDialog):

    def __init__(self):
        super(WallThicknessDialog, self).__init__(Gui.getMainWindow())
        self.setWindowTitle("Wall thickness analysis (sphere method)")
        self.results = {}
        self.observing = False
        self.view_sg = None
        self._thin_faces = []
        self._cancel = False
        self._busy = False
        self.legend = None

        lay = QtWidgets.QVBoxLayout(self)
        self.info = QtWidgets.QLabel(
            "<b>Step 1</b> - select the part(s) (solid / Body / Part object,<br>"
            "or only some faces), enter the wall thickness limits, press ANALYZE.")
        lay.addWidget(self.info)

        form = QtWidgets.QFormLayout()

        def spin(val):
            s = QtWidgets.QDoubleSpinBox()
            s.setDecimals(3)
            s.setRange(0.01, 10000.0)
            s.setSingleStep(0.1)
            s.setValue(val)
            s.setSuffix(" mm")
            return s

        self.combo_n = QtWidgets.QComboBox()
        for n in SAMPLE_LIMITS:
            self.combo_n.addItem("up to %d points%s" % (n, "  (fast)" if n == SAMPLE_LIMITS[0] else ""), n)
        self.combo_n.setToolTip("Maximum number of inscribed spheres. Parts with more surface "
                                "points are sampled evenly. More points = finer detail but slower.")
        form.addRow("Sample points:", self.combo_n)

        self.s_min = spin(1.0)
        self.s_nom = spin(2.5)
        self.s_max = spin(4.0)
        form.addRow("Minimum (blue):", self.s_min)
        form.addRow("Nominal (green):", self.s_nom)
        form.addRow("Maximum (red):", self.s_max)
        lay.addLayout(form)

        bar = QtWidgets.QLabel("  min  \u2192  nominal  \u2192  max")
        bar.setAlignment(QtCore.Qt.AlignCenter)
        bar.setStyleSheet("color:white; font-weight:bold; padding:3px;"
                          "background: qlineargradient(x1:0,y1:0,x2:1,y2:0,"
                          "stop:0 #0033ff, stop:0.5 #00d91a, stop:1 #ff0000);")
        lay.addWidget(bar)

        row = QtWidgets.QHBoxLayout()
        self.btn_run = QtWidgets.QPushButton("1. ANALYZE selected OBJECT(S)")
        self.btn_cancel = QtWidgets.QPushButton("Cancel")
        self.btn_cancel.setEnabled(False)
        row.addWidget(self.btn_run, 3)
        row.addWidget(self.btn_cancel, 1)
        lay.addLayout(row)

        self.report = QtWidgets.QPlainTextEdit()
        self.report.setReadOnly(True)
        self.report.setMinimumHeight(170)
        self.report.setMinimumWidth(440)
        lay.addWidget(self.report)
        self.status = QtWidgets.QLabel("")
        self.status.setWordWrap(True)
        lay.addWidget(self.status)

        row = QtWidgets.QHBoxLayout()
        self.btn_sel = QtWidgets.QPushButton("Select thin faces")
        self.btn_remove = QtWidgets.QPushButton("Remove analysis")
        self.btn_close = QtWidgets.QPushButton("Close")
        row.addWidget(self.btn_sel)
        row.addWidget(self.btn_remove)
        row.addWidget(self.btn_close)
        lay.addLayout(row)
        self.btn_sel.setEnabled(False)

        self.btn_run.clicked.connect(self.analyze)
        self.btn_cancel.clicked.connect(self._on_cancel)
        self.btn_sel.clicked.connect(self.select_thin)
        self.btn_remove.clicked.connect(self.remove_analysis)
        self.btn_close.clicked.connect(self.close)
        for s in (self.s_min, self.s_nom, self.s_max):
            s.valueChanged.connect(self.params_changed)

    # -- progress / cancel ----------------------------------------------
    def _on_cancel(self):
        self._cancel = True

    def _progress(self, msg=None):
        if msg:
            self.status.setText(msg)
        QtWidgets.QApplication.processEvents()
        if self._cancel:
            raise Cancelled()

    # -- analysis ---------------------------------------------------------
    def analyze(self):
        if self._busy:
            return
        targets = targets_from_selection()
        if not targets:
            self.status.setText("Nothing usable selected - select a solid, Body "
                                "or Part object.")
            return
        try:
            self.view_sg = Gui.ActiveDocument.ActiveView.getSceneGraph()
        except Exception:
            self.status.setText("No 3D view available.")
            return
        t_max = self.s_max.value()
        t_cap = max(1.1 * t_max, t_max + 0.5)
        self.remove_analysis(keep_observer=True)
        self._cancel = False
        self._busy = True
        self.btn_run.setEnabled(False)
        self.btn_cancel.setEnabled(True)
        QtWidgets.QApplication.setOverrideCursor(QtCore.Qt.WaitCursor)
        msgs = []
        try:
            for t in targets:
                obj, sh = t["obj"], t["shape"]
                diag = max(sh.BoundBox.DiagonalLength, 1e-9)
                tol = 0.05                                   # mm, fine tessellation (obstacles)
                self._progress("%s: tessellating ..." % obj.Name)
                for _ in range(4):
                    meshes = []
                    for k, f in enumerate(sh.Faces):
                        if k % 25 == 0:
                            self._progress()
                        meshes.append(face_mesh(f, tol))
                    nv = sum(len(m[0]) for m in meshes if m is not None)
                    if nv <= 400000:
                        break
                    tol *= 2.0
                # coarser tessellation for the sample points / colour map, so that the
                # number of spheres stays near the chosen limit however fine the model is
                n_samples = self.combo_n.currentData() or SAMPLE_LIMITS[0]
                n_obst = min(200000, max(60000, 2 * n_samples))
                tol_o = 0.1
                org = None
                for _ in range(6):
                    org = []
                    for k, f in enumerate(sh.Faces):
                        if k % 25 == 0:
                            self._progress()
                        org.append(face_mesh(f, tol_o) if k in t["sample"] else None)
                    nvo = sum(len(m[0]) for m in org if m is not None)
                    if nvo <= 0.8 * n_samples or tol_o >= 0.5:
                        break
                    tol_o *= 1.5
                try:
                    res = analyze_meshes(meshes, sorted(t["sample"]), t_cap, self._progress,
                                         n_obst=n_obst, n_org=n_samples, org_meshes=org)
                except Cancelled:
                    raise
                except Exception as e:
                    msgs.append("%s: %s" % (obj.Name, e))
                    continue
                res.update({"obj": obj, "plain": t["plain"], "diag": diag})
                self.results[obj.Name] = res
                self._progress("%s: creating colour map ..." % obj.Name)
                self._make_overlay(res)
                msgs.append("%s: %d sample points" % (obj.Name, len(res["V"])))
        except Cancelled:
            self.remove_analysis(keep_observer=True)
            msgs = ["Cancelled."]
        finally:
            QtWidgets.QApplication.restoreOverrideCursor()
            self._busy = False
            self.btn_run.setEnabled(True)
            self.btn_cancel.setEnabled(False)
        self._observe(bool(self.results))
        if self.results:
            self._show_legend()
            self.info.setText("Change the limits to re-colour instantly. Click a face in the "
                              "3D view to print the thickness there.")
        self.status.setText("; ".join(msgs))
        self.refresh()

    # -- colour map overlay (Coin3D, nothing is added to the document) ----
    def _colors(self, res):
        return colors3(res["thick"], self.s_min.value(), self.s_nom.value(), self.s_max.value())

    def _make_overlay(self, res):
        lift = max(0.08, 2e-5 * res["diag"])
        P = res["V"] + _unit(res["N"]) * lift
        n = len(P)
        sep = coin.SoSeparator()
        lm = coin.SoLightModel()
        lm.model = coin.SoLightModel.BASE_COLOR
        po = coin.SoPolygonOffset()
        po.factor = -1.0
        po.units = -1.0
        po.styles = coin.SoPolygonOffset.FILLED
        mb = coin.SoMaterialBinding()
        mb.value = coin.SoMaterialBinding.PER_VERTEX_INDEXED
        mat = coin.SoMaterial()
        mat.diffuseColor.setValues(0, n, self._colors(res).tolist())
        coords = coin.SoCoordinate3()
        coords.point.setValues(0, n, P.tolist())
        idx = np.hstack([res["T"], -np.ones((len(res["T"]), 1), dtype=np.int64)])
        ifs = coin.SoIndexedFaceSet()
        ifs.coordIndex.setValues(0, idx.size, idx.ravel().tolist())
        for node in (lm, po, mb, mat, coords, ifs):
            sep.addChild(node)
        self.view_sg.addChild(sep)
        res["sep"] = sep
        res["mat"] = mat

    def _show_legend(self):
        try:
            if self.legend is None:
                vw = view_widget()
                if vw is None:
                    return
                self.legend = LegendWidget(vw)
            self.legend.set_limits(self.s_min.value(), self.s_nom.value(), self.s_max.value())
            self.legend.show()
            self.legend.raise_()
        except Exception:
            self.legend = None

    def _hide_legend(self):
        if self.legend is not None:
            try:
                self.legend.hide()
                self.legend.deleteLater()
            except Exception:
                pass
            self.legend = None

    def params_changed(self):
        if self.legend is not None:
            self.legend.set_limits(self.s_min.value(), self.s_nom.value(), self.s_max.value())
        for res in self.results.values():
            try:
                col = self._colors(res)
                res["mat"].diffuseColor.setValues(0, len(col), col.tolist())
            except Exception:
                pass
        if self.results:
            self.refresh()

    # -- report ---------------------------------------------------------
    def refresh(self):
        lo, hi = self.s_min.value(), self.s_max.value()
        lines = ["Limits: min %s   nominal %s   max %s"
                 % (user_len(lo), user_len(self.s_nom.value()), user_len(hi)), ""]
        self._thin_faces = []
        for name, res in self.results.items():
            if hi > res["t_cap"] / 1.1 + 1e-9:
                lines.append("NOTE: maximum was raised after the analysis - press ANALYZE "
                             "again to measure walls above %s." % user_len(res["t_cap"] / 1.1))
            g, faces = thickness_stats(res, lo, hi)
            lines.append("== %s ==" % name)
            if g["min"] is None:
                lines.append("   no thickness could be determined (open shell?)")
                continue
            p = g["min_pos"]
            lines.append("   thinnest: %s   at (%.2f, %.2f, %.2f)" % (user_len(g["min"]), p[0], p[1], p[2]))
            top = "%s (or more)" % user_len(g["max"]) if g["max"] >= res["t_cap"] - 1e-6 else user_len(g["max"])
            lines.append("   thickest: %s" % top)
            lines.append("   mean (area weighted): %s" % user_len(g["mean"]))
            lines.append("   area thinner than min: %.1f %%    thicker than max: %.1f %%"
                         % (100 * g["area_thin"], 100 * g["area_thick"]))
            bad = sorted([(v[0], fi, v) for fi, v in faces.items()
                          if v is not None and (v[0] < lo or v[2] > hi)])
            if bad:
                lines.append("   faces outside the limits (thinnest first):")
                for tmin_f, fi, v in bad[:30]:
                    flag = "THIN " if v[0] < lo else "THICK"
                    lines.append("     %s %s.Face%d  min %s  max %s"
                                 % (flag, name, fi + 1, user_len(v[0]), user_len(v[2])))
                    if v[0] < lo and res["plain"]:
                        self._thin_faces.append((name, "Face%d" % (fi + 1)))
                if len(bad) > 30:
                    lines.append("     ... and %d more" % (len(bad) - 30))
            else:
                lines.append("   all measured faces are within the limits")
            lines.append("")
        self.report.setPlainText("\n".join(lines))
        self.btn_sel.setEnabled(bool(self._thin_faces))

    def select_thin(self):
        Gui.Selection.clearSelection()
        doc = FreeCAD.ActiveDocument
        n = 0
        for name, sub in self._thin_faces:
            try:
                Gui.Selection.addSelection(doc.Name, name, sub)
                n += 1
            except Exception:
                pass
        self.status.setText("%d thin face(s) selected." % n)

    # -- click probing --------------------------------------------------
    def _observe(self, on):
        if on and not self.observing:
            Gui.Selection.addObserver(self)
            self.observing = True
        elif not on and self.observing:
            try:
                Gui.Selection.removeObserver(self)
            except Exception:
                pass
            self.observing = False

    def addSelection(self, doc, obj, sub, pnt):        # Selection observer API
        try:
            if self._busy or obj not in self.results or "Face" not in sub:
                return
            res = self.results[obj]
            o = FreeCAD.getDocument(doc).getObject(obj)
            face = get_shape(o, sub)
            P = Vector(pnt)
            u, v = face.Surface.parameter(P)
            if (face.valueAt(u, v) - P).Length > 1e-3 * max(res["diag"], 1.0):
                return
            n = face.normalAt(u, v)
            r = res["field"].radii(np.array([[P.x, P.y, P.z]]),
                                   np.array([[-n.x, -n.y, -n.z]]))[0]
            t = 2.0 * float(r)
            if t >= res["t_cap"] - 1e-6:
                msg = "%s.%s  wall thickness at clicked point: > %s\n" % (obj, sub, user_len(res["t_cap"]))
            else:
                msg = "%s.%s  wall thickness at clicked point: %s\n" % (obj, sub, user_len(t))
            FreeCAD.Console.PrintMessage(msg)
            self.status.setText(msg.strip())
        except Exception:
            pass

    # -- cleanup --------------------------------------------------------
    def remove_analysis(self, keep_observer=False):
        self._hide_legend()
        for res in self.results.values():
            try:
                self.view_sg.removeChild(res["sep"])
            except Exception:
                pass
        self.results = {}
        if not keep_observer:
            self._observe(False)
            self.report.setPlainText("")
            self.btn_sel.setEnabled(False)

    def closeEvent(self, ev):
        self._cancel = True
        self.remove_analysis()
        super(WallThicknessDialog, self).closeEvent(ev)

    def reject(self):
        self._cancel = True
        self.remove_analysis()
        super(WallThicknessDialog, self).reject()


_dialog = None


def main():
    global _dialog
    if FreeCAD.ActiveDocument is None:
        FreeCAD.Console.PrintError("Open a document first.\n")
        return
    if _dialog is not None:
        try:
            _dialog.remove_analysis()
            _dialog.close()
        except Exception:
            pass
    _dialog = WallThicknessDialog()
    _dialog.show()


main()
